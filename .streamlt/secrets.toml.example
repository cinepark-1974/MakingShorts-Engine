# .streamlit/secrets.toml.example
# 이 파일을 복사하여 secrets.toml 로 저장한 뒤 실제 키를 입력하세요.
# secrets.toml 은 .gitignore 에 포함되어 GitHub에 올라가지 않습니다.
#
# Streamlit Community Cloud 배포 시:
#   [Settings] > [Secrets] 탭에 아래 내용을 그대로 붙여 넣으세요.

ANTHROPIC_API_KEY  = "sk-ant-..."      # https://console.anthropic.com
ELEVENLABS_API_KEY = "sk_..."          # https://elevenlabs.io
FAL_KEY            = "..."             # https://fal.ai
