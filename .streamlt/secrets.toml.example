# .streamlit/secrets.toml.example
# 이 파일을 복사하여 secrets.toml 로 저장한 뒤 실제 키를 입력하세요.
# secrets.toml 은 .gitignore 에 포함되어 GitHub에 올라가지 않습니다.
#
# Streamlit Community Cloud 배포 시:
#   [Settings] > [Secrets] 탭에 아래 내용을 그대로 붙여 넣으세요.

# ── 필수 (3개) ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY  = "sk-ant-..."      # https://console.anthropic.com
ELEVENLABS_API_KEY = "sk_..."          # https://elevenlabs.io
FAL_KEY            = "..."             # https://fal.ai

# ── 선택 — 구글 드라이브 레퍼런스 이미지 연동 ──────────────────────────────
# 설정하면 씬 카드에 드라이브 이미지 드롭다운이 표시됩니다.
# 설정하지 않으면 URL 직접 입력 방식으로 폴백됩니다.
#
# GOOGLE_API_KEY 발급 방법:
#   1. https://console.cloud.google.com 접속
#   2. 프로젝트 생성 (또는 기존 프로젝트 선택)
#   3. "API 및 서비스" > "라이브러리" > "Google Drive API" 활성화
#   4. "API 및 서비스" > "사용자 인증 정보" > "API 키 만들기"
#   5. (권장) API 키 제한: Drive API만 허용
#
# GDRIVE_REF_FOLDER_ID 찾는 방법:
#   드라이브에서 레퍼런스 이미지 폴더 열기
#   → 주소창 URL: https://drive.google.com/drive/folders/{여기가 폴더ID}
#   → 폴더는 "링크가 있는 사용자 모두 (뷰어)" 로 공유 설정 필요
#
GOOGLE_API_KEY       = "AIza..."
GDRIVE_REF_FOLDER_ID = "1AbCdEf..."   # 폴더 URL 끝 부분 긴 문자열
